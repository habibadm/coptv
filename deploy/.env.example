# Copiar a .env (instalar.sh lo hace solo y genera las claves).

# Direcciones públicas. Ambas tienen que apuntar (registro A) a la IP de este servidor.
APP_DOMAIN=coptv.cop.org.py
PANEL_DOMAIN=panel.coptv.cop.org.py

# Puertos del servidor. Si el 80 y el 443 están ocupados (por ejemplo en un NAS),
# usar otros y en el router reenviar el 80 y 443 públicos a estos.
HTTP_PORT=8090
HTTPS_PORT=8453

# Bunny Stream
BUNNY_STREAM_HOST=vz-baf57f2c-727.b-cdn.net
# Clave de "Token Authentication" de la Pull Zone. Vacía = URLs sin firmar.
BUNNY_TOKEN_KEY=

# Señal en vivo (HLS). Vacía = señal de prueba.
LIVE_STREAM_URL=

# Claves internas: instalar.sh las genera. No compartirlas.
DB_PASSWORD=
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
