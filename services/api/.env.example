PORT=4000

# Carpeta con la app de TV compilada para servirla en la misma dirección (opcional).
WEB_DIR=

# CMS (Strapi). Vacío = se usa el catálogo de ejemplo.
CMS_URL=
# Opcional: el CMS ya permite leer el catálogo sin token.
CMS_TOKEN=
# Dirección pública de esta API; las imágenes del CMS se sirven desde ella en /uploads.
PUBLIC_URL=
# Segundos que la API guarda el catálogo en memoria.
CMS_CACHE_SEC=60

# Bunny.net
# Hostname de la Pull Zone de la librería de Bunny Stream (Stream > librería > API).
BUNNY_STREAM_HOST=vz-baf57f2c-727.b-cdn.net
# Clave de "Token Authentication" de esa Pull Zone. Vacía = URLs sin firmar.
BUNNY_TOKEN_KEY=
# Vigencia de cada URL firmada (segundos).
BUNNY_TOKEN_TTL_SEC=21600

# URL HLS de la señal en vivo de COPTV. Si sale por la CDN de Bunny (*.b-cdn.net), se firma.
LIVE_STREAM_URL=

# Mientras sea "false" no se devuelven pausas publicitarias.
ADS_ENABLED=false
# Etiqueta VAST/VMAP de Google Ad Manager u otro servidor de anuncios.
AD_TAG_URL=
